name = "opendata-app"
main = "src/index.js"
compatibility_date = "2026-08-01"

[vars]
AIG_ACCOUNT_ID = "e0a6739e7b8a94e272b76b9dc94a8efd"
AIG_GATEWAY_ID = "opendata-app"

[[d1_databases]]
binding = "DB"
database_name = "tokyo-population"
database_id = "2084d9c3-0ef6-45e8-a353-6b05434b2896"

[[r2_buckets]]
binding = "LAKE"
bucket_name = "opendata-lake"
